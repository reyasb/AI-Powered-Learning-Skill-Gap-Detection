# Database configuration (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./skillmap.db

# JWT Security
SECRET_KEY=skillmap_super_secret_jwt_key_change_in_production_2026_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration (Optional: set your OpenAI / Gemini API key)
# If left empty, SkillMap AI runs with built-in intelligent NLP and fallback heuristic RAG generators
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Document & Resume Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Server & CORS
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
